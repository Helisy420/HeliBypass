import { Theme } from "../theme.slint";
import { Card, Pill, Btn, Icon, Eyebrow, PageHeader, Field, Scroller } from "../components.slint";
import { AppState } from "../state.slint";
import { Icons } from "../icons.slint";

export component StrategiesPage inherits Rectangle {
    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 22px;
        padding-bottom: 22px;
        spacing: 16px;

        PageHeader {
            title: @tr("Strategies");
            subtitle: @tr("A strategy decides how the bypass disguises your traffic. Run tests to find the one that works best on your connection.");
            Btn {
                kind: 1;
                text: @tr("Run tests");
                icon: Icons.flask;
                clicked => { AppState.page = 3; }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            Rectangle {
                horizontal-stretch: 1;
                height: 42px;
                border-radius: 12px;
                background: Theme.surface;
                border-width: 1px;
                border-color: filter.has-focus ? Theme.accent : Theme.border;
                Icon {
                    source: Icons.search;
                    color: Theme.dim;
                    x: 14px;
                    y: 12px;
                }
                filter := TextInput {
                    x: 42px;
                    y: 0;
                    width: parent.width - 56px;
                    height: parent.height;
                    vertical-alignment: center;
                    font-size: 13px;
                    font-weight: 500;
                    color: Theme.text;
                    selection-background-color: Theme.accent.with-alpha(0.4);
                    selection-foreground-color: Theme.text;
                    single-line: true;
                    edited => { AppState.set-strategy-filter(self.text); }
                }
                if filter.text == "": Text {
                    x: 42px;
                    height: parent.height;
                    text: @tr("Filter strategies");
                    color: Theme.dim;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
            Text {
                horizontal-stretch: 0;
                text: AppState.bp-state == 2 ? @tr("Running · ") + AppState.bp-strategy : @tr("Selected · ") + AppState.bp-strategy;
                color: AppState.bp-state == 2 ? Theme.success : Theme.muted;
                font-size: 12.5px;
                font-weight: 500;
                vertical-alignment: center;
            }
        }

        Card {
            vertical-stretch: 1;
            Scroller {
                content-height: AppState.strategies.length * 66px + 16px;
                VerticalLayout {
                    padding: 8px;
                    spacing: 2px;
                    alignment: start;
                    for s in AppState.strategies: Rectangle {
                        height: 64px;
                        border-radius: 12px;
                        background: s.selected ? Theme.accent.with-alpha(0.08) : row-ta.has-hover ? Theme.surface2 : transparent;
                        border-width: s.selected ? 1px : 0px;
                        border-color: Theme.accent.with-alpha(0.7);
                        animate background { duration: 100ms; }
                        // the whole row selects; drawn first so the "Use" button stays on top
                        row-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppState.bp-select(s.name); }
                        }
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 14px;
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 4px;
                                Text {
                                    text: s.name;
                                    color: Theme.text;
                                    font-size: 14px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: s.technique;
                                    color: Theme.muted;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }
                            if s.note != "": VerticalLayout {
                                alignment: center;
                                Pill {
                                    text: s.note;
                                    tone: 2;
                                    dot: false;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                if s.selected: Pill {
                                    text: @tr("Selected");
                                    tone: 4;
                                }
                                if !s.selected: Btn {
                                    kind: 1;
                                    height: 34px;
                                    pad: 16px;
                                    text: @tr("Use");
                                    clicked => { AppState.bp-select(s.name); }
                                }
                            }
                        }
                    }
                    if AppState.strategies.length == 0: Rectangle {
                        height: 120px;
                        Text {
                            text: @tr("No strategy matches the filter.");
                            color: Theme.dim;
                            font-size: 12.5px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
