import { Theme } from "theme.slint";
import { Card, Pill, Btn, Icon, Toggle } from "components.slint";
import { AppState } from "state.slint";
import { Icons } from "icons.slint";

component TrayRow inherits Rectangle {
    in property <image> glyph;
    in property <string> title;
    in property <string> sub;
    in property <bool> sub-warn: false;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();
    height: 34px;
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 30px;
            height: 30px;
            y: 2px;
            border-radius: 9px;
            background: Theme.surface2;
            border-width: 1px;
            border-color: Theme.border;
            Icon {
                source: root.glyph;
                color: Theme.accent;
                size: 15px;
                x: 7.5px;
                y: 7.5px;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 12.5px;
                overflow: elide;
            }
            Text {
                text: root.sub;
                color: root.sub-warn ? Theme.amber : Theme.dim;
                font-size: 10.5px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Toggle {
                width: 38px;
                height: 22px;
                checked: root.checked;
                enabled: root.enabled;
                toggled(v) => { root.toggled(); }
            }
        }
    }
}

// The small control panel that opens when the tray icon is clicked.
export component TrayMenu inherits Window {
    in property <image> app-icon;
    // logical size, read by the Rust side to place the window next to the tray icon
    out property <length> panel-width: 296px;
    out property <length> panel-height: lay.preferred-height;
    callback open-app();
    callback quit();

    title: "Heli Bypass";
    icon: app-icon;
    no-frame: true;
    always-on-top: true;
    background: Theme.window;
    default-font-family: Theme.sans;
    default-font-weight: 500;
    width: panel-width;
    height: panel-height;

    lay := VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 10px;
            Image {
                source: Icons.mark;
                width: 28px;
                height: 28px;
                y: 2px;
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text {
                    text: "Heli Bypass";
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                }
                HorizontalLayout {
                    alignment: start;
                    Pill {
                        height: 20px;
                        text: AppState.protected ? @tr("Protected") : @tr("Not protected");
                        tone: AppState.protected ? 1 : 3;
                    }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        TrayRow {
            glyph: Icons.send;
            title: @tr("Telegram proxy");
            sub: AppState.tg-busy ? @tr("Starting…") : AppState.tg-running ? AppState.tg-addr + " · " + AppState.tg-route : @tr("Stopped");
            checked: AppState.tg-running;
            enabled: !AppState.tg-busy;
            toggled => { AppState.tg-toggle(); }
        }
        TrayRow {
            glyph: Icons.shield;
            title: @tr("Bypass");
            sub: !AppState.admin ? @tr("Needs administrator rights") : AppState.bp-state == 3 ? @tr("Failed") : AppState.bp-strategy;
            sub-warn: !AppState.admin || AppState.bp-state == 3;
            checked: AppState.bp-state == 2 || AppState.bp-state == 1;
            enabled: AppState.admin;
            toggled => { AppState.bp-toggle(); }
        }
        VerticalLayout {
            spacing: 5px;
            Text {
                text: @tr("Strategy");
                color: Theme.muted;
                font-size: 11px;
            }
            field := Rectangle {
                // the list opens below the field when it fits, otherwise above it
                property <length> list-h: min(196px, AppState.strategies.length * 30px + 10px);
                property <length> below: root.height - (self.absolute-position.y + self.height) - 6px;
                property <length> above: self.absolute-position.y - 6px;
                property <bool> drop-up: self.below < self.list-h && self.above > self.below;
                height: 34px;
                border-radius: 9px;
                background: fta.has-hover ? #1C2547 : Theme.surface2;
                border-width: 1px;
                border-color: Theme.border;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 10px;
                    Text {
                        horizontal-stretch: 1;
                        text: AppState.bp-strategy;
                        color: Theme.text;
                        font-size: 12.5px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Icon {
                        source: Icons.chevron-down;
                        color: Theme.muted;
                        size: 16px;
                        y: (parent.height - self.height) / 2;
                    }
                }
                fta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { pick.show(); }
                }
                pick := PopupWindow {
                    x: 0;
                    height: min(field.list-h, max(60px, field.drop-up ? field.above : field.below));
                    y: field.drop-up ? -self.height - 4px : field.height + 4px;
                    width: field.width;
                    Rectangle {
                        background: Theme.surface2;
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: Theme.border;
                        clip: true;
                        Flickable {
                            content-height: AppState.strategies.length * 30px + 10px;
                            VerticalLayout {
                                padding: 5px;
                                for s in AppState.strategies: Rectangle {
                                    height: 30px;
                                    border-radius: 7px;
                                    background: sta.has-hover ? Theme.border : s.selected ? Theme.accent.with-alpha(0.15) : transparent;
                                    Text {
                                        x: 9px;
                                        width: parent.width - 18px;
                                        height: parent.height;
                                        text: s.name;
                                        color: s.selected ? Theme.accent : Theme.text;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    sta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { AppState.bp-select(s.name); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        HorizontalLayout {
            spacing: 8px;
            Btn {
                horizontal-stretch: 1;
                height: 36px;
                pad: 12px;
                font-size: 13px;
                text: @tr("Open Heli Bypass");
                clicked => { root.open-app(); }
            }
            Btn {
                kind: 1;
                height: 36px;
                pad: 14px;
                font-size: 13px;
                text: @tr("Quit");
                icon: Icons.power;
                clicked => { root.quit(); }
            }
        }
    }

    Rectangle {
        border-width: 1px;
        border-color: Theme.border;
        background: transparent;
    }
}
